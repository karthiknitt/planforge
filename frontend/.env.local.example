# This project has no local dev server / preview testing workflow - frontend
# testing happens on Vercel (preview + production deploys), backend on Cloud
# Run. This file is kept only as a reference for what vars exist; real values
# live in Vercel's env store (`vercel env add <NAME> production|preview`).
BETTER_AUTH_SECRET=<run: openssl rand -hex 32>
BETTER_AUTH_URL=https://planforge-mauve.vercel.app
DATABASE_URL=<neon-postgres-connection-string-for-better-auth-tables>
NEXT_PUBLIC_API_URL=https://planforge-backend-hoiaqu2xbq-uc.a.run.app
NEXT_PUBLIC_BETTER_AUTH_URL=https://planforge-mauve.vercel.app
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER

# AI — server-side only (never exposed to browser)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# OpenRouter (optional — enables any OpenRouter model in agent chat)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Arcjet — Shield (WAF) + per-user rate limiting on /api routes. Get a key at
# https://app.arcjet.com. Add it to Vercel for production + preview; routes
# fail open (no-op) if unset so a missing key never breaks a deploy.
ARCJET_KEY=ajkey_...
