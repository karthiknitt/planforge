BETTER_AUTH_SECRET=changeme-generate-a-real-random-secret
BETTER_AUTH_URL=http://localhost:3001
DATABASE_URL=postgresql://planforge:planforge@db:5432/planforge
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

# Server-side only — mints the short-lived token the backend proxy uses to
# verify requests. Must match backend/.env's INTERNAL_AUTH_SECRET exactly.
INTERNAL_AUTH_SECRET=changeme-generate-a-real-random-secret
# FastAPI backend URL for server-side calls (proxy route, fetchBackend helper).
# Not NEXT_PUBLIC_ — never needed in the browser bundle.
BACKEND_URL=http://localhost:8000

# AI — server-side only (never exposed to browser)
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENROUTER_API_KEY=your-openrouter-key
