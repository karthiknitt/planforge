# Reference only - real values are set per-environment via
# `vercel env add <NAME> production|preview` and picked up on Vercel's own
# build. There is no local dev server / preview testing for this app; unit
# tests (`bun test`) set their own env vars inline per-test and don't read
# this file (see e.g. backend-fetch.test.ts, route.test.ts).
BETTER_AUTH_SECRET=changeme-generate-a-real-random-secret
BETTER_AUTH_URL=https://planforge-mauve.vercel.app
DATABASE_URL=<neon-postgres-connection-string-for-better-auth-tables>
NEXT_PUBLIC_BETTER_AUTH_URL=https://planforge-mauve.vercel.app
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

# Server-side only — mints the short-lived token the backend proxy uses to
# verify requests. Must match the Cloud Run backend's INTERNAL_AUTH_SECRET
# exactly (see scripts/gcp-cloud-run-setup.sh, which sets both together).
INTERNAL_AUTH_SECRET=changeme-generate-a-real-random-secret
# FastAPI Cloud Run backend URL for server-side calls (proxy route,
# fetchBackend helper). Not NEXT_PUBLIC_ — never needed in the browser bundle.
BACKEND_URL=https://planforge-backend-hoiaqu2xbq-uc.a.run.app

# AI — server-side only (never exposed to browser)
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENROUTER_API_KEY=your-openrouter-key
