# Reference only - this backend is not run or tested locally. Real values live
# as GitHub Actions secrets (gh secret set, or scripts/gcp-cloud-run-setup.sh)
# and are injected into Cloud Run at deploy time by .github/workflows/deploy-backend.yml.
# The only supported local action is `docker build .` to validate the Dockerfile.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?ssl=require
ALLOWED_ORIGINS=https://planforge-mauve.vercel.app
DB_USE_NULLPOOL=true
INTERNAL_AUTH_SECRET=changeme-generate-a-real-random-secret
# StructAgent structural-design API (structapi). Empty = feature disabled
# (the /structural endpoint returns 503). Set via GH Actions secrets:
#   gh secret set STRUCTURAL_API_URL --body 'https://structapi-xxx.run.app'
#   gh secret set STRUCTURAL_API_KEY --body '<key>'
STRUCTURAL_API_URL=
STRUCTURAL_API_KEY=

# Razorpay payments — empty = payments disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI render layer (Phase 2) — provider picked at bake-off; empty = render tab disabled
RENDER_PROVIDER=
RENDER_MODEL=
RENDER_DAILY_QUOTA=20
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Async job pipeline (Inngest) — both empty => inline synchronous fallback
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Must be distinct per deployment (main vs solver-split) — Inngest ties
# function registration to this name; two deployments sharing an app_id
# race for which URL actually receives invocations.
INNGEST_APP_ID=planforge
JOB_QUEUED_TIMEOUT_S=120

# Rate limiting — in-process token bucket (app/middleware/rate_limit.py)
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SECOND=0.2

# Cloudflare R2 artifact storage — all four empty => NullStorage (no-op,
# exports stream inline as before R2). See docs/guides/cloudflare-r2-setup.md
# for the full setup guide. Set via GH Actions secrets:
#   gh secret set R2_ACCOUNT_ID        --body '<your-account-id>'
#   gh secret set R2_ACCESS_KEY_ID     --body '<your-access-key-id>'
#   gh secret set R2_SECRET_ACCESS_KEY --body '<your-secret-access-key>'
#   gh secret set R2_BUCKET            --body 'planforge-artifacts'
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# "inline" streams bytes through Cloud Run (default). "redirect" 307s to a
# presigned R2 URL — only flip after verifying the frontend download path
# and configuring bucket CORS (see the R2 setup guide, section 6).
EXPORT_DELIVERY_MODE=inline
# Concurrent PDF/DXF renders per instance — ReportLab builds in memory and
# Cloud Run's filesystem is RAM-backed, so this is the real OOM guard.
EXPORT_MAX_CONCURRENCY=2
